<!--map page-->
<!-- 开屏封面：显示 1.5s 后淡出 -->
<view wx:if="{{showSplash}}" class="splash {{splashFade ? 'splash-hide' : ''}}">
  <image class="splash-img" src="/images/cover.png" mode="aspectFill"/>
</view>

<!-- 顶部悬浮提示：地图露出后显示 5 秒，随后淡出。pointer-events:none 不挡地图点击 -->
<view wx:if="{{showHint}}" class="map-hint {{hintFade ? 'map-hint-hide' : ''}}">
  <text class="map-hint-text">点击区域查看排片</text>
</view>

<!-- TIFF 引导层（当天第一次打开）：灰色遮罩在地图之上、按钮之下；点遮罩关闭 -->
<view wx:if="{{showGuide}}" class="tiff-guide" catchtap="closeGuide" catchtouchmove="noop">
  <view class="guide-arrow" style="{{guideArrowStyle}}">
    <view class="ga-head"></view>
    <view class="ga-shaft"></view>
  </view>
  <view class="guide-text" style="{{guideTextStyle}}">
    <text class="gt-main">TIFF2026排片</text>
    <text class="gt-sub">东京国际映画祭 10/26〜11/4 · 点按钮进入</text>
  </view>
</view>

<!-- TIFF 悬浮入口：右上角，可拖动（拖动不触发跳转，轻点才进入）。尺寸按屏幕宽度等比放大 -->
<view
  wx:if="{{tiffOn && tiffStyle}}"
  class="tiff-fab {{tiffDragging ? 'tiff-fab-drag' : ''}} {{showGuide ? 'tiff-fab-pulse' : ''}}"
  style="{{tiffStyle}}"
  catchtouchstart="onTiffTouchStart"
  catchtouchmove="onTiffTouchMove"
  catchtouchend="onTiffTouchEnd"
  catchtouchcancel="onTiffTouchEnd"
>
  <image wx:if="{{!tiffImgErr}}" class="tiff-fab-img" src="{{tiffImg}}" mode="aspectFit" binderror="onTiffImgError"/>
  <view wx:else class="tiff-fab-fallback"><text>TIFF 2026</text></view>
</view>

<!-- 竖版底图宽度铺满屏幕；整图只挂一个 tap，命中判定在 JS 里做多边形检测 -->
<scroll-view scroll-x scroll-y class="scroll">
  <view class="map-wrap" style="width:{{mapWidth}}px;height:{{mapHeight}}px">
    <image
      class="map-img"
      src="/images/tokyo_map.png"
      mode="scaleToFill"
      style="width:{{mapWidth}}px;height:{{mapHeight}}px"
      bindtap="onMapTap"
    />
    <!-- 命中区域的高亮闪烁（按多边形 bbox 定位） -->
    <view wx:if="{{activeStyle}}" class="spot-ripple" style="{{activeStyle}}"/>
  </view>
</scroll-view>
