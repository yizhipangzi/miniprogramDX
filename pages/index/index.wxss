page {
  background-color: #0d0d1a;
}

/* 开屏封面 */
.splash {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #0d0d1a;
  opacity: 1;
  transition: opacity 0.4s ease;
}

.splash-hide {
  opacity: 0;
}

.splash-img {
  width: 100%;
  height: 100%;
}

.scroll {
  height: 100vh;
}

/* 顶部悬浮提示（z-index 低于开屏封面、高于地图；不拦截点击） */
.map-hint {
  position: fixed;
  top: 28rpx;
  left: 50%;
  z-index: 500;
  transform: translateX(-50%);
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  background: rgba(13, 13, 26, 0.85);
  border: 2rpx solid rgba(233, 69, 96, 0.55);
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.5);
  opacity: 1;
  transition: opacity 0.4s ease;
  pointer-events: none;
  animation: hint-in 0.35s ease-out;
}

.map-hint-hide {
  opacity: 0;
}

.map-hint-text {
  color: #f0f0f5;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

@keyframes hint-in {
  from { opacity: 0; transform: translate(-50%, -24rpx); }
  to   { opacity: 1; transform: translate(-50%, 0); }
}

/* 宽高由 JS 按「宽度铺满屏幕」等比算好后以内联 style 下发 */
.map-wrap {
  position: relative;
}

.map-img {
  display: block;
}

/* 命中区域高亮：left/top/width/height 由 JS 按多边形 bbox 内联下发 */
.spot-ripple {
  position: absolute;
  border-radius: 12rpx;
  background: rgba(233, 69, 96, 0.22);
  border: 2rpx solid rgba(233, 69, 96, 0.8);
  box-shadow: 0 0 20rpx rgba(233, 69, 96, 0.45);
  animation: spot-flash 0.38s ease-out forwards;
  pointer-events: none;
}

@keyframes spot-flash {
  0%   { opacity: 0;   transform: scale(0.88); }
  45%  { opacity: 1;   transform: scale(1.04); }
  100% { opacity: 0.85; transform: scale(1); }
}
